# このファイルをコピーして .env を作り、値を入れてください（.env は GitHub に上がりません）
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
BASE_URL=http://localhost:4900
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- 決済（Stripe）。未設定なら「仮の決済」で流れだけ確認できる
# まずはテスト用のキー（sk_test_…）で試す。本番キー（sk_live_…）は STRIPE_ALLOW_LIVE=1 を入れたときだけ使う
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=
# 決済失敗などの社内通知先
ADMIN_NOTIFY_EMAIL=nishihara@platinum-kikaku.co.jp
# 特商法ページなどの「トップへ戻る」リンク先
SITE_URL_FOOD=
SITE_URL_CLINIC=
